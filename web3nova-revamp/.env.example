# Copy to .env.local (never commit real values). Set the same names in Vercel.

# Monnify (Dashboard → Developer → API Keys). Use https://api.monnify.com for live.
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Public site URL, used for the Monnify redirect after payment
NEXT_PUBLIC_SITE_URL=https://www.web3nova.org

# SMTP for confirmation emails (Gmail: create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Web3Nova <you@example.com>"

# Testing only: charge this amount (e.g. 100) instead of the real prices. Never set in production.
# NEXT_PUBLIC_BOOTCAMP_TEST_PRICE=100

# Optional: also notify the team on each payment
BOOTCAMP_ADMIN_EMAIL=

# ---- Workspace (/workspace) ----
# Postgres database: add Neon in Vercel (Storage tab) and it sets DATABASE_URL for you.
DATABASE_URL=
# Password for /workspace/admin (username defaults to "admin")
WORKSPACE_ADMIN_USER=admin
WORKSPACE_ADMIN_PASSWORD=
# Optional: also email the team on each workspace booking
WORKSPACE_ADMIN_EMAIL=
# Telegram bot (from @BotFather), a random secret, and the Telegram user IDs allowed to use it
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
# Lets the daily renewal-reminder job (vercel.json cron) run
CRON_SECRET=
